# BuildOrbit — Environment Variables
#
# Copy to .env and set values for your environment.

# ── AI / LLM ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# Optional OpenAI-compatible base URL (defaults to https://api.openai.com/v1 when unset)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Server ───────────────────────────────────────────────────────────────────
# Public base URL for links, Stripe redirects, CLI, and email templates
APP_URL=http://localhost:3000

PORT=3000
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Required in production. Must be at least 32 bytes.
JWT_SECRET=

# ── Email (Postmark) ──────────────────────────────────────────────────────────
# POSTMARK_SERVER_TOKEN or POSTMARK_TOKEN — required for magic links and transactional mail
POSTMARK_SERVER_TOKEN=
# POSTMARK_TOKEN=

# Sender address (must be verified in Postmark)
EMAIL_FROM=noreply@buildorbit.com

# ── Billing ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# Callback URL: {APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Access Control ────────────────────────────────────────────────────────────
ADMIN_USER_IDS=

# ── Development Only ──────────────────────────────────────────────────────────
MOCK_MODE=false
